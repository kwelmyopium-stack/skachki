<Window x:Class="skachki.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Скачки" Height="500" Width="900"
        WindowStartupLocation="CenterScreen">
    <TabControl>

        <!-- ===== ЛОШАДИ ===== -->
        <TabItem Header="Лошади">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="5">
                    <Button Content="Добавить"      Width="100" Margin="0,0,5,0" Click="AddHorse_Click"/>
                    <Button Content="Редактировать" Width="120" Margin="0,0,5,0" Click="EditHorse_Click"/>
                    <Button Content="Удалить"       Width="100" Click="DeleteHorse_Click"/>
                </StackPanel>
                <DataGrid x:Name="dgHorses" AutoGenerateColumns="False"
                          IsReadOnly="True" SelectionMode="Single" Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"      Binding="{Binding HorseID}" Width="50"/>
                        <DataGridTextColumn Header="Кличка"  Binding="{Binding Name}"    Width="*"/>
                        <DataGridTextColumn Header="Порода"  Binding="{Binding Breed}"   Width="*"/>
                        <DataGridTextColumn Header="Возраст" Binding="{Binding Age}"     Width="80"/>
                        <DataGridTextColumn Header="Масть"   Binding="{Binding Color}"   Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- ===== ЖОКЕИ ===== -->
        <TabItem Header="Жокеи">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="5">
                    <Button Content="Добавить"      Width="100" Margin="0,0,5,0" Click="AddJockey_Click"/>
                    <Button Content="Редактировать" Width="120" Margin="0,0,5,0" Click="EditJockey_Click"/>
                    <Button Content="Удалить"       Width="100" Click="DeleteJockey_Click"/>
                </StackPanel>
                <DataGrid x:Name="dgJockeys" AutoGenerateColumns="False"
                          IsReadOnly="True" SelectionMode="Single" Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"       Binding="{Binding JockeyID}"  Width="50"/>
                        <DataGridTextColumn Header="Имя"      Binding="{Binding FirstName}"  Width="*"/>
                        <DataGridTextColumn Header="Фамилия"  Binding="{Binding LastName}"   Width="*"/>
                        <DataGridTextColumn Header="Возраст"  Binding="{Binding Age}"        Width="80"/>
                        <DataGridTextColumn Header="Страна"   Binding="{Binding Country}"    Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- ===== ЗАЕЗДЫ ===== -->
        <TabItem Header="Заезды">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="5">
                    <Button Content="Добавить"      Width="100" Margin="0,0,5,0" Click="AddRace_Click"/>
                    <Button Content="Редактировать" Width="120" Margin="0,0,5,0" Click="EditRace_Click"/>
                    <Button Content="Удалить"       Width="100" Click="DeleteRace_Click"/>
                </StackPanel>
                <DataGrid x:Name="dgRaces" AutoGenerateColumns="False"
                          IsReadOnly="True" SelectionMode="Single" Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"          Binding="{Binding RaceID}"                            Width="50"/>
                        <DataGridTextColumn Header="Дата"        Binding="{Binding RaceDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                        <DataGridTextColumn Header="Место"       Binding="{Binding Location}"                          Width="*"/>
                        <DataGridTextColumn Header="ID Лошади"   Binding="{Binding HorseID}"                           Width="90"/>
                        <DataGridTextColumn Header="ID Жокея"    Binding="{Binding JockeyID}"                          Width="90"/>
                        <DataGridTextColumn Header="Позиция"     Binding="{Binding Place}"                             Width="80"/>
                        <DataGridTextColumn Header="Дистанция"   Binding="{Binding Distance}"                          Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

    </TabControl>
</Window>
